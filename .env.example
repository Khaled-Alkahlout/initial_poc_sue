# These settings belong to the Python server, never to NEXT_PUBLIC_* variables.
# Defaults support historical viewing, replay, offline mock and offline tests.
SUE_ENABLE_SQL_RUNS=0
SUE_TEST_DATABASE_CONFIRMED=0
SUE_ENABLE_LLM=1
SUE_LLM_PROVIDER=openrouter
SUE_MODEL=anthropic/claude-haiku-5.5
# Extra model-ID's voor AI Settings, optioneel en kommagescheiden:
# SUE_ALLOWED_MODELS=anthropic/claude-sonnet-5.5
SUE_MAX_OUTPUT_TOKENS=4096
SUE_REASONING_EFFORT=low
OPENROUTER_API_KEY=
# Vul de DSN of de losse RDS-velden in voor de databaseverbinding.
SUE_DATABASE_URL=
# ENDPOINT=
# PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASS=
# PGSSLROOTCERT=.local/rds-region-bundle.pem
# Zet beide SQL-flags alleen op 1 voor een geïsoleerde testdatabase.
# ANTHROPIC_API_KEY=  # Alleen voor de bestaande Anthropic-experimenten via CLI.
# SUE_DATA_DIR=C:/path/to/local/dashboard-data
