# These settings belong to the Python server, never to NEXT_PUBLIC_* variables.
# Defaults support historical viewing, replay, offline mock and offline tests.
SUE_ENABLE_SQL_RUNS=0
SUE_TEST_DATABASE_CONFIRMED=0
SUE_ENABLE_LLM=0
# Set only for a dedicated, isolated test database:
# SUE_DATABASE_URL=postgresql://...
# SUE_MODEL=your-explicitly-selected-model
# ANTHROPIC_API_KEY=...
# SUE_DATA_DIR=C:/path/to/local/dashboard-data
